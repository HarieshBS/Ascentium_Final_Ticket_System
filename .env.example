# Copy to .env and fill in. Never commit .env.
LLM_BASE_URL=https://your-llm-host.example
LLM_MODEL=qwen3-4b
LLM_API_KEY=
LLM_TIMEOUT=120
WORKERS=3
OPS_TOKEN=change-me
# Docker: the database name. Change it to switch to a new, empty storage location.
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me
# Without Docker, set the full URL instead:
# DATABASE_URL=postgresql://tickets:change-me@localhost:5432/tickets
